# --- OpenRouter (--duzenle adimi icin) -------------------------------------
# https://openrouter.ai adresinden bir API anahtari alin.
OPENROUTER_API_KEY=
# OpenRouter'in sabit API adresi; degistirmeniz gerekmez.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter'daki model kimligi, ornek: anthropic/claude-sonnet-5,
# anthropic/claude-haiku-4.5, openai/gpt-4o-mini. Tam liste: https://openrouter.ai/models
OPENROUTER_MODEL=

# --- Deepgram (--konusmaci-ayir adimi icin) ---------------------------------
# https://console.deepgram.com/ adresinden bir API anahtari alin. Bu adim
# kullanildiginda ses dosyasi transkripsiyon + konusmaci ayrimi icin
# Deepgram'a gonderilir (yerel Whisper adimi atlanir, bkz. README).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Secrets only. Everything else is configured in a TOML file (see voicescribe.example.toml).
# The variable names below are themselves configurable (api_key_env keys).

# Needed for --diarize (Deepgram). Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Needed for --edit (any OpenAI-compatible API, OpenRouter by default). https://openrouter.ai
OPENROUTER_API_KEY=

# Any config key can also be set here as VOICESCRIBE__<SECTION>__<KEY>, e.g.:
# VOICESCRIBE__EDITING__LLM__MODEL=anthropic/claude-haiku-4.5
